{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": ["bash .claude/hooks/pre-edit-invariants.sh $TOOL_INPUT"]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          "bash .claude/hooks/post-edit-lint.sh $TOOL_INPUT",
          "bash .claude/hooks/post-edit-test.sh $TOOL_INPUT"
        ]
      }
    ]
  }
}
